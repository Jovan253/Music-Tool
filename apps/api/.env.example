# Backend server bind settings
API_HOST=0.0.0.0
API_PORT=8000

# Postgres. Local: the docker compose service below. Production: Neon connection
# string (console.neon.tech). A postgres:// URL is normalized automatically.
DATABASE_URL=postgresql://musictool:musictool@localhost:5432/musictool

# Redis / RQ — local only, and on the way out: the job queue is moving to
# Modal .spawn(), after which these and the separate worker process disappear.
REDIS_URL=redis://localhost:6379/0
RQ_REDIS_URL=redis://localhost:6379/0

# Supabase — auth, and file storage until the R2 migration lands
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# Cloudflare R2 object storage (migration target — not read by any code yet).
# Account ID: dash.cloudflare.com -> R2 -> Overview, right-hand sidebar.
# Access keys: R2 -> API -> Manage API tokens -> Create, with Object Read & Write.
# Create both buckets first; names must match what the API expects.
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET_UPLOADS=uploads
R2_BUCKET_STEMS=stems

# Secret key for signing tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change-me

# Comma-separated list of allowed CORS origins
# Production: set to your Vercel app URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Demucs device for the local CPU fallback only — auto-detected if not set.
# Irrelevant when MODAL_TOKEN_ID is set, since separation then runs on Modal's GPU.
DEMUCS_DEVICE=cpu
# DEMUCS_DEVICE=cuda  # assert GPU is available (job fails with clear error if no GPU)

# Retention — a daily Modal cron deletes a job's upload and stems once it is older
# than this, marks the job "expired", and thereby also keeps the Supabase free-tier
# project from auto-pausing. Each job is ~20-60MB against a 1GB free tier.
STEM_RETENTION_DAYS=14

# Job ids the retention sweep must never touch, comma-separated. Intended for the
# public demo job, whose stems have to survive indefinitely.
RETENTION_EXEMPT_JOB_IDS=

# Modal GPU inference — set these to offload Demucs to a Modal T4 GPU (~25s vs ~12min on CPU)
# Get tokens at: https://modal.com/settings/tokens
# If not set, worker falls back to local CPU separation
MODAL_TOKEN_ID=ak-your-token-id
MODAL_TOKEN_SECRET=as-your-token-secret
