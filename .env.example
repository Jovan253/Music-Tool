# ==============================================================================
# INDEX ONLY — NOTHING LOADS THIS FILE.
#
# Copying this to a root `.env` has no effect. The apps each read their own:
#
#   Backend   ->  apps/api/.env      (main.py, workers/separation.py, alembic/env.py)
#   Frontend  ->  apps/web/.env      (Vite, VITE_ prefixed vars only)
#
# This file exists as a single place to see every variable both apps need.
# Copy the real templates instead:
#
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
# ==============================================================================


# ------------------------------------------------------------------------------
# Backend — apps/api/.env
# ------------------------------------------------------------------------------

# Server bind settings
API_HOST
API_PORT

# Postgres. Local: docker compose. Production: Neon connection string.
DATABASE_URL

# Redis / RQ. Removed once the job queue moves to Modal .spawn().
REDIS_URL
RQ_REDIS_URL

# Supabase — auth, and file storage until the R2 migration lands.
# SERVICE_ROLE_KEY is a secret: server-side only, never in a VITE_ var.
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY

# Cloudflare R2 object storage (migration target — not read by any code yet)
R2_ACCOUNT_ID
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
R2_BUCKET_UPLOADS
R2_BUCKET_STEMS

# Token signing secret — generate with: openssl rand -hex 32
SECRET_KEY

# Comma-separated allowed CORS origins. Must include the Vercel URL in production.
CORS_ORIGINS

# Demucs device for the local CPU fallback only: cpu | cuda
DEMUCS_DEVICE

# Retention window in days (default 14), and job ids the sweep must never delete.
STEM_RETENTION_DAYS
RETENTION_EXEMPT_JOB_IDS

# Modal credentials. Presence of MODAL_TOKEN_ID is what switches separation to GPU.
MODAL_TOKEN_ID
MODAL_TOKEN_SECRET


# ------------------------------------------------------------------------------
# Frontend — apps/web/.env
# ------------------------------------------------------------------------------
# Every VITE_ var is compiled into the client bundle and is world-readable.

VITE_API_BASE_URL
VITE_SUPABASE_URL
VITE_SUPABASE_ANON_KEY
